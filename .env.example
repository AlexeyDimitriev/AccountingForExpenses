# Скопируйте в .env перед запуском Docker Compose.
APP_VERSION=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

POSTGRES_USER=expenses
POSTGRES_DB=expenses
# Пример пароля только для локального учебного окружения.
POSTGRES_PASSWORD=expenses_local_password

# Имя db доступно внутри Compose. pgx берёт пользователя, пароль и БД из PGUSER/PGPASSWORD/PGDATABASE.
DATABASE_URL=host=db port=5432 sslmode=disable

LOG_LEVEL=INFO
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
DB_CONNECT_TIMEOUT=5s
HEALTH_CHECK_TIMEOUT=2s
# Должен превышать HTTP_SHUTDOWN_TIMEOUT, чтобы сервер успел завершить запросы.
CONTAINER_STOP_TIMEOUT=15s
